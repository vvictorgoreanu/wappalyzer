/node_modules
/backup
.DS_Store

# Local-only inputs. See scripts/lib/untracked.js — everything that reads these
# degrades with a stated reason when they are absent.
#
# A third party's product list and the per-product coverage it generates:
data/requested-products.json
docs/coverage.json
docs/coverage.md
scripts/lib/requested-mapping.js
# StackLookup exports (top-500 list, per-domain samples) and the Zeppelin
# queries that produce them (they list customer domains):
data/stacklookup-*.csv
data/zeppelin/
# StackLookup audit scan cache and verdicts. Regenerate with `npm run audit:stacklookup`:
data/stacklookup-scans/
data/stacklookup-audit.json
data/stacklookup-report.md
data/stacklookup-replay.md
#
# Bulky generated measurements. Regenerate with `npm run sweep` / `npm run audit:xhr`:
data/dns-sweep-domains.txt
data/dns-sweep-results.json
data/xhr-audit-urls.txt
data/xhr-audit-results.json
# Pattern triage output and its review batches. Regenerate with `npm run triage:patterns`:
data/pattern-triage.json
data/pattern-review/

# Puppeteer's downloaded browser.
/chrome
